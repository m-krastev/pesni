{title: ПСАЛОМ 100}

{start_of_chorus: Припев}
[C]АЛИЛУЯ, СЛАВА, АЛИЛУ[Am]Я! /4
{end_of_chorus}

{start_of_verse: Куплет 1}
[C] [Am] [F] [G]
ХВАЛЕТЕ ГО, ТОЙ ЗАСЛУЖАВА! /4
{end_of_verse}

{chorus: Припев}

{start_of_verse: Куплет 2}
ТОЙ НИ НАПРАВИ -/4
НЕГОВИ СМЕ НИЕ!
{end_of_verse}

{chorus: Припев}

{start_of_verse: Куплет 3}
ПОЗНАЙТЕ, ЧЕ ГОСПОД Е БОГ! /4
{end_of_verse}

{chorus: Припев}

{start_of_verse: Куплет 4}
ЕЛАТЕ ЗАЕДНО СЪС НАС
ВЪВ ДВОРОВЕТЕ МУ /2
С ХВАЛЕНИЕ!
{end_of_verse}

{chorus: Припев}

{start_of_verse: Куплет 5}
СЛУЖЕТЕ ГОСПОДУ С ВЕСЕЛИЕ! /4
{end_of_verse}

{chorus: Припев}
