# Акорди: местата са взети от оригиналния PDF static/old_chords/30-slava-blagodarnost_akord.pdf
{title: СЛАВА, БЛАГОДАРНОСТ}

{start_of_verse: Куплет 1}
[Dm]СЛА[C7]ВА,
[F]БЛАГО[B]ДАР[B]НОСТ[A][Dm][Gm] [C7]СА[F]МО [Gm]
[B]НА [A]И[Dm]СУСА! /3
{end_of_verse}

{start_of_verse: Куплет 2}
ИСУС, ВЗЕМИ МЕ И
УПОТРЕБИ! /3
{end_of_verse}

{start_of_verse: Куплет 3}
ИСКАМ ДА НОСЯ АЗ
БЛАГАТА ВЕСТ! /3
{end_of_verse}

{start_of_chorus: Припев}
АЛИЛУЯ! /6
{end_of_chorus}
