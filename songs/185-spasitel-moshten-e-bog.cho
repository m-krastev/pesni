{title: СПАСИТЕЛ МОЩЕН Е БОГ}

{start_of_verse: Куплет 1}
[C2]ОТ МИЛОСТ ВСЕКИ СЕ НУЖДАЕ, [G]
ОТ ЛЮБОВ НЕПРОМЕНИМА, [Em]
ОТ НЕБЕСНА [D]БЛАГОДАТ. [C]

ОТ ПРОШКА ВСЕКИ СЕ НУЖДАЕ, [G]
ОТ ДОБРИНАТА НА СПАСИТЕЛ - [Em]
НАДЕЖДА НА [D]СВЕТА. [C] [D] [C] [D]
{end_of_verse}

{start_of_chorus: Припев}
ИЗБАВЯ, [G]ПРЕМЕСТВА ПЛАНИНИТЕ [D]
СПАСИТЕЛ МОЩЕН Е БОГ! [C] [G]
ДА, МОЩЕН Е [Em]БОГ! [D]

ВЕЧНО СПАСЕНИЕ ДАРЯВА, [G] [D]
ВЪЗКРЪСНА И ПОБЕДИ, [C] [G]
ИСУС СМЪРТТА ПОБЕДИ! [Em] [D]
{end_of_chorus}

{start_of_verse: Куплет 2}
[C2]КАКЪВТО СЪМ - ВЗЕМИ МЕ. [G]
В СТРАХ И В НЕУСПЕХИ, [Em]
ИЗПЪЛВАЙ МЕ С [D]ЖИВОТ! [C]

ПОСВЕЩАВАМ СЕ ДА ПОСЛЕДВАМ [G]
ВСИЧКО, В КОЕТО ВЯРВАМ, [Em]
ПРЕДАВАМ СЕ [D]НА ТЕБ. [C] [D] [C] [D]
{end_of_verse}

{start_of_bridge: Мост}
[C]СВЕТЛИНАТА ТИ ИЗГРЯ В [G]СВЕТА! [D]
[Em]ПЕЕМ: „[C]ТОЙ ВЪЗКРЪСНА,
[G]СЛАВЕН ЦАР Е БОГ!“ [D]
([Em]ИСУСЕ) [C] [G]
{end_of_bridge}
