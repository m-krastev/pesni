{title: СКОРО, МНОГО СКОРО}

{start_of_verse: Интро}
[E] [A] [E]
[E] [A] [E] [E]
[E] [A] [E] [C#m]
{end_of_verse}

{start_of_verse: Куплет 1}
[E]СКОРО, МНОГО СКОРО
НИЙ ЩЕ ВИДИМ ГОСПОДА! [A]/3 [E] [C#m]
{end_of_verse}

{start_of_chorus: Припев}
[A]АЛИЛУЯ! [B]АЛИЛУЯ!
ЩЕ ВИДИМ ГОСПОДА! [A] [B] [E]
{end_of_chorus}

{start_of_verse: Куплет 2}
[E]ТАМ НЯМА СКРЪБ!
НИЙ ЩЕ ВИДИМ ГОСПОДА! [A]/3 [E] [C#m]
{end_of_verse}

{start_of_chorus: Припев}
[A]АЛИЛУЯ! [B]АЛИЛУЯ!
ЩЕ ВИДИМ ГОСПОДА! [A] [B] [E]
{end_of_chorus}

{start_of_verse: Куплет 3}
[E]ТАМ НЯМА СМЪРТ!
НИЙ ЩЕ ВИДИМ ГОСПОДА! [A]/3 [E] [C#m]
{end_of_verse}

{start_of_chorus: Припев}
[A]АЛИЛУЯ! [B]АЛИЛУЯ!
ЩЕ ВИДИМ ГОСПОДА! [A] [B] [E]
{end_of_chorus}
