# Акорди: местата са взети от оригиналния PDF static/old_chords/28-skoro-mnogo-skoro_akord.pdf
{title: СКОРО, МНОГО СКОРО}

{start_of_verse: Интро}
[E] [A] [E]
[E] [A] [E] [E]
[E] [A] [E] [C#m]
{end_of_verse}

{start_of_verse: Куплет 1}
[E]СКОРО, МНОГО СКОРО
[A]НИЙ ЩЕ [E]ВИДИМ ГОС[C#m]ПОДА! /3
{end_of_verse}

{start_of_chorus: Припев}
А[A]ЛИЛУЯ! А[B]ЛИЛУЯ!
ЩЕ [A]ВИДИМ [B]ГОСПО[E]ДА!
{end_of_chorus}

{start_of_verse: Куплет 2}
ТАМ НЯМА СКРЪБ!
НИЙ ЩЕ ВИДИМ ГОСПОДА! /3
{end_of_verse}

{start_of_chorus: Припев}
АЛИЛУЯ! АЛИЛУЯ!
ЩЕ ВИДИМ ГОСПОДА!
{end_of_chorus}

{start_of_verse: Куплет 3}
ТАМ НЯМА СМЪРТ!
НИЙ ЩЕ ВИДИМ ГОСПОДА! /3
{end_of_verse}

{start_of_chorus: Припев}
АЛИЛУЯ! АЛИЛУЯ!
ЩЕ ВИДИМ ГОСПОДА!
{end_of_chorus}
