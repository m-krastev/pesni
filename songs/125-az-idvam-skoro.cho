{title: АЗ ИДВАМ СКОРО}

{start_of_verse: Куплет 1}
АЗ ИДВАМ СКОРО,
МОИ ЧАДА.
БЪДЕТЕ ВИЙ
ГОТОВИ ОТСЕГА.
{end_of_verse}

{start_of_verse: Куплет 2}
И СВОИТЕ СЪРЦА
ВИЙ ОЧИСТЕТЕ,
ЛЪЖА И ЗЛОБА,
ВИЙ МАХНЕТЕ!
{end_of_verse}

{start_of_verse: Куплет 3}
АЗ ИДВАМ СКОРО
ТУК, ЗА ДА ВИ ВЗЕМА.
НО, ЗНАЙТЕ ВИЙ ДОБРЕ,
МОИ ЧАДА,
{end_of_verse}

{start_of_verse: Куплет 4}
ЧЕ НИЩО МРЪСНО
ТАМ НЕ ЩЕ ДА ВЛЕЗЕ
ВЪВ ЦАРСТВОТО
НА ВЕЧНОСТТА.
{end_of_verse}

{start_of_verse: Куплет 5}
АЗ ИДВАМ СКОРО,
ВИЙ СЕ ПРИГОТВЕТЕ.
И ТВЪРДИ СТОЙТЕ
ДО ПОСЛЕДНИЙ ДЕН.
{end_of_verse}

{start_of_verse: Куплет 6}
НАГРАДА СЪМ
ПРИГОТВИЛ НА НЕБЕТО
ЗА ВСИЧКИ ВЕРНИ,
ИСКРЕНИ ЧАДА.
{end_of_verse}

{start_of_verse: Куплет 7}
ПОКАЙТЕ СЕ,
СМИРЕТЕ СЕ ПРЕД МЕНЕ.
ЖИВЕЙТЕ БЛАГОЧЕСТИВО
НА СВЕТА.
{end_of_verse}

{start_of_chorus: Припев}
ИЗПЪЛВАЙТЕ СЕ
СЪС СИЛА ОТ ДУХА МИ.
ЛЮБЕТЕ СЕ,
МОИ ЧАДА.
{end_of_chorus}
