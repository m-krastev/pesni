{title: ДУХЪТ НА ГОСПОДА}

{start_of_verse: Куплет 1}
[G]ДУХЪТ НА ГОСПОДА Е ТУК! /2 [D] [C] [G]
[G]ДУХЪТ НА [D]ГОСПОДА
ОТ НЕБЕСА[Em]ТА Е [C]ТУК,
[G]ДУХЪТ НА ГОСПОДА Е [D]ТУ[G]К!
{end_of_verse}

{start_of_verse: Куплет 2}
[G]ПОМАЗАНИЕТО НА БОГ Е ТУК! /2 [D] [C] [G]
[G]ПОМАЗАНИЕТО НА [D]БОГ
ОТ НЕБЕСА[Em]ТА Е [C]ТУК,
[G]ПОМАЗАНИЕТО НА БОГ Е [D]ТУ[G]К!
{end_of_verse}

{start_of_verse: Куплет 3}
[G]ИЗЦЕЛЕНИЕТО НА БОГ Е ТУК! /2 [D] [C] [G]
[G]ИЗЦЕЛЕНИЕТО НА [D]БОГ
ОТ НЕБЕСА[Em]ТА Е [C]ТУК,
[G]ИЗЦЕЛЕНИЕТО НА БОГ Е [D]ТУ[G]К!
{end_of_verse}

{start_of_verse: Куплет 4}
[G]СИЛАТА НА БОГ Е ТУК /2 [D] [C] [G]
[G]СИЛАТА НА [D]БОГ
ОТ НЕБЕСА[Em]ТА Е [C]ТУК,
[G]СИЛАТА НА БОГ Е [D]ТУ[G]К!
{end_of_verse}

{start_of_verse: Куплет 5}
[G]ИСУС ХРИСТОС Е ТУК! /2 [D] [C] [G]
[G]ИСУС [D]ХРИСТОС
ОТ НЕБЕСА[Em]ТА Е [C]ТУК,
[G]ИСУС ХРИСТОС Е [D]ТУ[G]К!
{end_of_verse}
