#let song = [
= 178. ЛЮБОВТА

_(1 КОРИНТЯНИ 13 ГЛАВА)_ \

=== [[Куплет 1]]
АКО ГОВОРЯ \
С АНГЕЛСКИ ЕЗИЦИ, \
АКО ЗНАЯ ВСИЧКИ ТАЙНИ, \
АКО ИМАМ ВСЯКО ЗНАНИЕ, \
АКО МОГА ПЛАНИНИТЕ \
ДА ПРЕМЕСТЯ, \
АКО ДАМ ИМОТА СИ \
НА ГЛАДНИТЕ, \
АКО ДАМ ТЕЛОТО НА СМЪРТТА... \

=== [[Припев]]
ЛЮБОВТА, ЛЮБОВТА \
АКО ЛИПСВА \
ВЪВ СЪРЦАТА НИ, \
НИЙ СМЕ МЕД ЩО ЗВЪНТИ \
И КИМВАЛ ЩО ДРЪНКА! \

=== [[Куплет 2]]
ЛЮБОВТА ТЪРПИ И НЕ ЗАВИЖДА, \
НЕ СЕ ПРЕВЪЗНАСЯ \
И НЕ СЕ ГОРДЕЕ, \
ВСИЧКО ПРЕМЪЛЧАВА, \
НА ВСИЧКО ХВАЩА ВЯРА, \
НА ВСИЧКО СЕ НАДЯВА, \
ВСИЧКО ПРЕТЪРПЯВА, \
НЕ СЕ РАЗДРАЗНЯВА, \
НЕ ТЪРСИ СВОЕТО, \
НЕ РАДВА СЕ НА ЗЛО, \
КОПНЕЕ ЗА ДОБРО. \

=== [[Куплет 3]]
ЗНАЙТЕ, ЛЮБОВТА \
НИВГА НЕ ОТПАДА \
КАКТО ДРУГИ ДАРБИ, \
КОИТО ПРЕКРАТЯВАТ \
ЗАЩОТО, ОТЧАСТИ \
ДНЕС ВИЖДАМЕ НЕЩАТА \
В ТОЗИ СВЯТ ИЗПЪЛНЕН \
С ГРЯХ И СУЕТА. \
И ТЪЙ, ОСТАВАТ ВЯРА, \
НАДЕЖДА И ЛЮБОВ, \
НО НАЙ-ГОЛЯМАТА Е ЛЮБОВТА. \
]
