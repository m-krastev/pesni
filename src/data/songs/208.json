{"id": "208", "sections": [{"title": "Куплет 1", "lines": [[[null, "ЩЕ ХВАЛИМ НАШИЯ ЦАР!"]], [[null, "ЩЕ СЕ ПОКЛАНЯМЕ ДНЕС"]], [[null, "И ЩЕ ИЗДИГНЕМ СВЯТИ РЪЦЕ."]], [[null, "ЩЕ ХВАЛИМ НАШИЯ ЦАР!"]]]}, {"title": "Припев", "lines": [[[null, "ЩЕ ГО ХВАЛИМ"]], [[null, "ВСЯКА СУТРИН,"]], [[null, "ХВАЛИМ ВСЯКА НОЩ,"]], [[null, "ХВАЛИМ ВСЕКИ ДЕН."]], [[null, "И ЩЕ ИЗДИГНЕМ"]], [[null, "ИМЕТО НА ИСУС."]], [[null, "ЧУЙ НИЕ ПЕЕМ СЕГА -"]], [[null, "ЩЕ ХВАЛИМ НАШИЯ ЦАР!"]]]}]}
