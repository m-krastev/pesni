{"id": "147", "sections": [{"title": "Куплет 1", "lines": [[[null, "СКОРО ЦЯЛА ЗЕМЯ"]], [[null, "ЩЕ МОЖЕ РАЗБРА"]], [[null, "КОЙ НАЙ-ВЕЛИК ВЛАДЕТЕЛ Е"]], [[null, "НА ВСЕЛЕНАТА."]], [[null, "МЕСИЯ Е ТОЙ И НЕПОБЕДИМ"]], [[null, "И ИДВА ТОЙ СКОРО"]], [[null, "ДА СЪДИ СВЕТА."]], [[null, "СЕГА И ТИ СЕ СМИРИ"]], [[null, "И МИЛОСТТА ПРИЕМИ!"]], [[null, "ЩОМ ПОВЯРВАШ"]], [[null, "В ИСУСА ХРИСТА"]], [[null, "ТИ ОЧИСТЕН СИ ОТ ГРЕХА."]]]}, {"title": "Припев", "lines": [[[null, "СВИРЯТ ТРЪБИТЕ"]], [[null, "ОТ СИОНА,"]], [[null, "ГОСПОД ИДВА"]], [[null, "С ГОЛЯМА СЛАВА."]], [[null, "СВИРЯТ ТРЪБИТЕ"]], [[null, "ОТ СИОНА,"]], [[null, "ТОЙ ИДВА ОТ НЕБЕ!"]]]}]}
