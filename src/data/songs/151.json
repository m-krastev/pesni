{"id": "151", "sections": [{"title": "Куплет 1", "lines": [[[null, "ДАВАМ ТИ ЖИВОТА СИ,"]], [[null, "ОТ ТЕБ, ИСУС, НУЖДАЯ СЕ!"]], [[null, "ОБРЪЩАМ СЕ КЪМ ТЕБ"]], [[null, "И ТИ СИ ТАМ!"]], [[null, "В ТРУДНОСТИ АЗ ТЪРСЯ ТЕБ,"]], [[null, "В ЖИВОТА СИ ИЗДИГАМ ТЕ,"]], [[null, "СМИРЯВАМ СЕ ПРЕД ТЕБ,"]], [[null, "ПРЕД ТЕБ ИСУС!"]]]}, {"title": "Припев", "lines": [[[null, "ПЪТЯ, ИСУС -"]], [[null, "БИХ ЖИВЯЛ"]], [[null, "ЕДИНСТВЕНО ЗА ТЕБЕ!"]]]}, {"title": "Куплет 2", "lines": [[[null, "ТИ СИ ВИНАГИ СЪС МЕН"]], [[null, "НАВСЯКЪДЕ И ВСЕКИ ДЕН,"]], [[null, "МИЛОСТТА ТИ Е ДЪЛБОКО В МЕН!"]], [[null, "НЯМА ДА СЕ ПРОМЕНИШ"]], [[null, "ВЧЕРА, ДНЕС, ЗАВИНАГИ -"]], [[null, "ЗАВИНАГИ, ЗА ВЕЧНОСТТА!"]]]}, {"title": "Припев 2", "lines": [[[null, "ПЪТЯ, ЖИВОТА, ИСТИНАТА -"]], [[null, "СЪС ВЯРА ХОДИМ,"]], [[null, "НЕ СЪС ВИЖДАНЕ -"]], [[null, "ЗА ТЕБ, ЖИВЕЕМ ДНЕС ЗА ТЕБ!"]]]}]}
