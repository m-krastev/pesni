{"id": "218", "sections": [{"title": "Куплет 1", "lines": [[[null, "МОЖЕ БИ СИ МИСЛИШ,"]], [[null, "ЧЕ Е ГЛУПАВО,"]], [[null, "НО КАЗВАМ ТИ, НЕ СЕ СРАМЯ!"]], [[null, "МОЛИХ БОГА,"]], [[null, "ГРЕХОВЕТЕ МИ ВЗЕМА,"]], [[null, "И АЗ СЪМ ВЕЧЕ НОВ ЧОВЕК!"]], null, [[null, "\"НОВ ЧОВЕК\"!"]], [[null, "О КОЛКО ЧУДНО Е ТОВА."]], [[null, "\"НОВ ЧОВЕК\"! - САМ ИСУС КАЗА."]], [[null, "\"НОВ ЧОВЕК\","]], [[null, "И ВСИЧКО ТАМ НА ГОЛГОТА -"]], [[null, "КАК СЪМ ЩАСТЛИВ,"]], [[null, "ЧЕ СЪМ НОВОРОДЕН!"]], null, [[null, "НЯКОЙ ДОЙДЕ ПРИ ИСУСА"]], [[null, "ПРЕЗ НОЩТА"]], [[null, "В ЙОАНА ТРЕТАТА ГЛАВА"]], [[null, "\"ВЯРВАМ АЗ,"]], [[null, "УЧИТЕЛЮ, ОТ БОГА СИ.\""]], [[null, "ИСУС КАЗА: \"ОТНОВО СЕ РОДИ!\""]], null, [[null, "НОВО СЪЗДАНИЕ,"]], [[null, "АЗ СЪМ НОВ ЧОВЕК."]], [[null, "СТАРОТО ПРЕМИНА,"]], [[null, "ВСИЧКО НОВО Е."]], [[null, "В ИСУСА НИЙ СМЕ ПОБЕДИТЕЛИ."]], [[null, "НОВО СЪЗДАНИЕ,"]], [[null, "АЗ СЪМ НОВ ЧОВЕК"]], null, [[null, "\"НОВ ЧОВЕК\"!"]], [[null, "О КОЛКО ЧУДНО Е ТОВА."]], [[null, "\"НОВ ЧОВЕК\"! - САМ ИСУС КАЗА."]], [[null, "\"НОВ ЧОВЕК\","]], [[null, "И ВСИЧКО ТАМ НА ГОЛГОТА -"]], [[null, "КАК СЪМ ЩАСТЛИВ,"]], [[null, "ЧЕ СЪМ НОВОРОДЕН!"]], null, [[null, "НО СЕГА, ОТСТЪПИХ АЗ НА БОГА,"]], [[null, "ДАВАЙКИ НА НЕГО"]], [[null, "ПЪЛНА ПРЕДНИНА."]], [[null, "ТОЙ Е МОЯ ПРЪВ ВОДИТЕЛ,"]], [[null, "СМЕЛО С НЕГО"]], [[null, "КЪМ НЕБЕТО АЗ ВЪРВЯ!"]]]}]}
