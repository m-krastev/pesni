{"id": "229", "sections": [{"title": "Куплет 1", "lines": [[[null, "ДНЕС ПЕЯ ИЗПОВЕД"]], [[null, "ЗА ГОЛЯМО СПАСЕНИЕ."]], [[null, "ВЪВ ЖИВИЯ БОГ"]], [[null, "АЗ НАМЕРИХ ИЗКУПЛЕНИЕ."]]]}, {"title": "Припев", "lines": [[[null, "АЛИЛУЯ! АЛИЛУЯ!"]], [[null, "АЛИЛУЯ! АЛИЛУЯ!"]]]}, {"title": "Куплет 2", "lines": [[[null, "ДУШАТА МИ ОТНОВО"]], [[null, "ИЗПЪЛВА СЕ С ХВАЛЕНИЕ."]], [[null, "ЧРЕЗ ТЕБ, ИСУСЕ, ПРЕЛИВА В МЕН"]], [[null, "РАДОСТ, БЛАГОДАРЕНИЕ."]]]}, {"title": "Куплет 3", "lines": [[[null, "С ЛЮБОВ ВЪРВЯ УВЕРЕНО,"]], [[null, "ПОБЕЖДАВАЙКИ СТРАХА В МЕН."]], [[null, "ИЗПОВЕДТА МИ Е ЗА ТЕБ,"]], [[null, "ЧЕ ТИ ИЗБАВИ МЕ ОТ ПЛЕН."]]]}]}
