{"id": "181", "sections": [{"title": "Куплет 1", "lines": [[[null, "И ГОСПОД ЩЕ ИЗДИГНЕ"]], [[null, "СВОЯТ ГЛАС ВЕЛИК"]], [[null, "И ТИ ЩЕ ИМАШ ПЕСЕН В НОЩТА,"]], [[null, "ЕЛА НА ПЛАНИНАТА ПРИ ГОСПОДА,"]], [[null, "ВИЖ НЕГОВАТА СЛАВА И МОЩ."]]]}, {"title": "Припев", "lines": [[[null, "ТОЙ Е МОЩНИЯТ НА ИЗРАЕЛ, / 2"]], [[null, "ЩЕ СЕ ЗАРАДВА"]], [[null, "ЗЕМЯТА В ГОСПОДА."]], [[null, "ТОЙ Е МОЩНИЯТ НА ИЗРАЕЛ."]]]}, {"title": "Куплет 2", "lines": [[[null, "ОЧИТЕ НА СЛЕПИТЕ"]], [[null, "ЩЕ СЕ ВЪЗОБНОВЯТ"]], [[null, "И ЩЕ ПРОЧУЯТ ГЛУХИТЕ!"]], [[null, "КУЦИ ЩЕ СКАЧАТ, ЩЕ СЕ ВЕСЕЛЯТ"]], [[null, "ВСЕКИ ДЕН И ЧАС!"]]]}, {"title": "Куплет 3", "lines": [[[null, "ЩЕ ВЪРШИ БОГ ЗНАМЕНИЯ"]], [[null, "ПО ЦЯЛАТА ЗЕМЯ."]], [[null, "СЪС СИЛА ЩЕ ВОЮВА ТОЙ ЗА НАС."]], [[null, "СЕГА С ГЛАС НА РАДОСТ"]], [[null, "И ТИ ВЪЗКЛИКНИ:"]], [[null, "ТОЙ Е МОЩНИЯТ НА ИЗРАЕЛ!"]]]}]}
