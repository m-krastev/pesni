{"id": "180", "sections": [{"title": "Куплет 1", "lines": [[[null, "ПЕТЪР С ЙОАНА СЕ СПРЯ,"]], [[null, "ПРЕД ХРАМА ВИДЯ КУЦ ЧОВЕК."]], [[null, "ТОЙ ПРОСЕШЕ МИЛОСТИНЯ"]], [[null, "И ЕТО, ЧЕ ПЕТЪР КАЗА:"]]]}, {"title": "Куплет 2", "lines": [[[null, "ЗЛАТО СРЕБРО НЯМАМ АЗ,"]], [[null, "НО ДРУГО ЩЕ ТИ ДАРЯ."]], [[null, "ВЪВ ИМЕТО НА ИСУСА ХРИСТА"]], [[null, "ТИ КАЗВАМ: \"СТАНИ И ХОДИ!\""]]]}, {"title": "Куплет 3", "lines": [[[null, "И ТОЙ СТАНА"]], [[null, "И СЛАВЕШЕ БОГА СВОЙ."]], [[null, "СТАНА И СЛАВЕШЕ БОГА СВОЙ."]], [[null, "ВЪВ ИМЕТО НА ИСУСА ХРИСТА"]], [[null, "ТИ КАЗВАМ: \"СТАНИ И ХОДИ!\""]]]}, {"title": "Куплет 4", "lines": [[[null, "ВСИЧКИ ВИДЯХА ТОВА"]], [[null, "И МНОГО СЕ СМАЯХА."]], [[null, "НО ПЕТЪР ИМ ОБЯСНИ,"]], [[null, "ЧЕ ГОСПОД"]], [[null, "ТОЗ' КУЦ ЧОВЕК ИЗЦЕРИ."]]]}]}
