{"id": "174", "sections": [{"title": "Куплет 1", "lines": [[[null, "ТАТКО НЕБЕСЕН,"]], [[null, "ТИ СИ ВЕЛИК!"]], [[null, "ТИ СИ ЧУДЕСЕН, НЕПРОМЕНИМ."]]]}, {"title": "Припев", "lines": [[[null, "ВДИГАМ КЪМ ТЕБЕ"]], [[null, "СВОЙТЕ РЪЦЕ,"]], [[null, "АЗ ТЕ ОБИЧАМ"]], [[null, "СЪС ЦЯЛО СЪРЦЕ!"]]]}, {"title": "Куплет 2", "lines": [[[null, "СКЪПИ ИСУСЕ,"]], [[null, "ТИ СИ ЗА МЕН"]], [[null, "МОЯ СПАСИТЕЛ,"]], [[null, "МОЙ ГОСПОД И ЦАР."]]]}, {"title": "Куплет 3", "lines": [[[null, "СВЯТ ДУХ БОЖЕСТВЕН -"]], [[null, "ДУХ НА ЛЮБОВ"]], [[null, "С МЪДРОСТ И СИЛА"]], [[null, "ТИ МЕ ВОДИ."]]]}]}
