{"id": "071", "sections": [{"title": "Куплет 1", "lines": [[[null, "ВЛЕЗ В ПОРТИТЕ С БЛАГОДАРНОСТ,"]], [[null, "В ДВОРОВЕТЕ МУ С ХВАЛА."]], [[null, "В ПРИСЪСТВИЕТО МУ СЪС РАДОСТ"]], [[null, "ПЕЙ \"ВЕЛИК И МОЩЕН Е ГОСПОД\"!"]]]}, {"title": "Куплет 2", "lines": [[[null, "ХВАЛЕТЕ ГО С КИМВАЛ И СЪС АРФА"]], [[null, "ХВАЛЕТЕ ГО СЪС ЗВУК НА ТРОМПЕТ!"]], [[null, "СЪЗДАНИЯТА НА НЕБЕ И ЗЕМЯ"]], [[null, "ДА ИЗДИГНАТ ГЛАС, ПЕЯТ ОТ СЪРЦЕ:"]]]}, {"title": "Припев 1", "lines": [[["Bb", "ГОСПОД Е ДОБЪР!"]], [["Am", "ГОСПОД Е ДОБЪР!"]], [["Gm", "ГОСПОД Е ДОБЪР!"]], [["Bb", "МИЛОСТТА МУ"]], [["C", "ПРЕБЪДВА ДО "], ["F", "ВЕКА!"]]]}, {"title": "Припев 2", "lines": [[["Dm", "ГОСПОД Е "], ["Bb", "ДОБЪР!"]], [["C", "МИЛОСТТА МУ"]], [[null, "ПРЕБЪДВА ДО "], ["F", "ВЕКА!"]]]}, {"title": "Куплет 3", "lines": [[[null, "ИСУС, СИНЪТ Е ИЗДИГНАТ,"]], [[null, "СЪЗДАТЕЛ НА ВСИЧКО Е ТОЙ."]], [[null, "ПРЕД НЕГО ТИ КОЛЕНИЧИ ДНЕС,"]], [[null, "ИЗДИГНИ РЪЦЕ, ПЕЙ ХВАЛЕНИЕ!"]]]}]}
