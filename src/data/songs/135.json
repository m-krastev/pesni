{"id": "135", "sections": [{"title": "Куплет 1", "lines": [[[null, "САМОТЕН БЯХ ВЪВ ТОЗИ СВЯТ"]], [[null, "И ОТЧАЯН."]], [[null, "НО БОГ ДОЙДЕ И ПРОМЕНИ"]], [[null, "ЖИВОТА МИ."]], [[null, "И АЗ СЕГА РАЗБРАХ"]], [[null, "КАКЪВ Е СМИСЪЛА"]], [[null, "НА ЖИВОТА МИ."]]]}, {"title": "Припев", "lines": [[[null, "ЦАРЮ МОЙ, ЦАРЮ МОЙ,"]], [[null, "БЕЗ ТЕБ НЕ МОГА ДА ЖИВЕЯ"]], [[null, "НА ТАЗИ, НА ТАЗИ ГРЕШНА ЗЕМЯ."]]]}, {"title": "Куплет 2", "lines": [[[null, "ОТ ТВОЕТО ПРИСЪСТВИЕ"]], [[null, "ИЗТРЪПВАМ БОЖЕ!"]], [[null, "РАЗТАПЯМ СЕ ОТ ТВОЯТА"]], [[null, "ГОРЕЩА ТОПЛИНА."]], [[null, "О, КОЛКО ХУБАВО"]], [[null, "МИ Е СЪС ТЕБЕ!"]], [[null, "БЕЗ ТЕБ НЕ МОГА АЗ!"]]]}]}
