{"id": "142", "sections": [{"title": "Куплет 1", "lines": [[[null, "НЕЖНО ТИ МИНАВАШ"]], [[null, "ПОКРАЙ МЕН,"]], [[null, "ЧУВСТВАМ ТЕ СЕГА ДО МЕН."]], [[null, "НЕЖНО ГАЛИШ МЕ С РЪКА,"]], [[null, "ТИ РАЗТАПЯШ МОЯТА ДУША."]]]}, {"title": "Припев", "lines": [[[null, "ИСУСЕ, ИСУСЕ,"]], [[null, "ДЕН И НОЩ СИ ТИ ДО МЕН."]], [[null, "КАК ДА ТИ СЕ ОТПЛАТЯ -"]], [[null, "ОСВЕН ЖИВОТА СИ"]], [[null, "ДА ТИ ДАРЯ."]]]}, {"title": "Куплет 2", "lines": [[[null, "СЛЪНЦЕ СИ В ЖИВОТА МИ,"]], [[null, "ТИ ОГРЯВАШ ПЪТИЩАТА МИ."]], [[null, "СЛЪНЦЕ СИ В ЖИВОТА МИ,"]], [[null, "БЕЗ ТЕБ НЕ МОГА, ГОСПОДИ!"]]]}]}
