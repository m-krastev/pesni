{"id": "125", "sections": [{"title": "Куплет 1", "lines": [[[null, "АЗ ИДВАМ СКОРО,"]], [[null, "МОИ ЧАДА."]], [[null, "БЪДЕТЕ ВИЙ"]], [[null, "ГОТОВИ ОТСЕГА."]]]}, {"title": "Куплет 2", "lines": [[[null, "И СВОИТЕ СЪРЦА"]], [[null, "ВИЙ ОЧИСТЕТЕ,"]], [[null, "ЛЪЖА И ЗЛОБА,"]], [[null, "ВИЙ МАХНЕТЕ!"]]]}, {"title": "Куплет 3", "lines": [[[null, "АЗ ИДВАМ СКОРО"]], [[null, "ТУК, ЗА ДА ВИ ВЗЕМА."]], [[null, "НО, ЗНАЙТЕ ВИЙ ДОБРЕ,"]], [[null, "МОИ ЧАДА,"]]]}, {"title": "Куплет 4", "lines": [[[null, "ЧЕ НИЩО МРЪСНО"]], [[null, "ТАМ НЕ ЩЕ ДА ВЛЕЗЕ"]], [[null, "ВЪВ ЦАРСТВОТО"]], [[null, "НА ВЕЧНОСТТА."]]]}, {"title": "Куплет 5", "lines": [[[null, "АЗ ИДВАМ СКОРО,"]], [[null, "ВИЙ СЕ ПРИГОТВЕТЕ."]], [[null, "И ТВЪРДИ СТОЙТЕ"]], [[null, "ДО ПОСЛЕДНИЙ ДЕН."]]]}, {"title": "Куплет 6", "lines": [[[null, "НАГРАДА СЪМ"]], [[null, "ПРИГОТВИЛ НА НЕБЕТО"]], [[null, "ЗА ВСИЧКИ ВЕРНИ,"]], [[null, "ИСКРЕНИ ЧАДА."]]]}, {"title": "Куплет 7", "lines": [[[null, "ПОКАЙТЕ СЕ,"]], [[null, "СМИРЕТЕ СЕ ПРЕД МЕНЕ."]], [[null, "ЖИВЕЙТЕ БЛАГОЧЕСТИВО"]], [[null, "НА СВЕТА."]]]}, {"title": "Припев", "lines": [[[null, "ИЗПЪЛВАЙТЕ СЕ"]], [[null, "СЪС СИЛА ОТ ДУХА МИ."]], [[null, "ЛЮБЕТЕ СЕ,"]], [[null, "МОИ ЧАДА."]]]}]}
