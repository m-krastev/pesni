{"id": "145", "sections": [{"title": "Куплет 1", "lines": [[[null, "АКО ТИ НЕ БЕ СЕ РОДИЛ,"]], [[null, "АКО ТИ НЕ БЕШЕ ОСЪДЕН,"]], [[null, "ЗА ГРЕХОВЕТЕ НИ"]], [[null, "НА ТАЗИ ЗЕМЯ"]], [[null, "АКО ТИ НЕ БЕШЕ ПЛАТИЛ,"]], [[null, "АКО ТИ НЕ БЕШЕ ВЪЗКРЪСНАЛ,"]], [[null, "ДАЛИ ТОЗИ ДЕН"]], [[null, "ЩЕШЕ ДА Е ВЕЛИК?"]]]}, {"title": "Припев", "lines": [[[null, "ВЪЗКРЪСНАЛ Е! ВЪЗКРЪСНАЛ Е!"]], [[null, "РАДВАЙТЕ СЕ ХОРА!"]], [[null, "ВЕЛИК ДА Е, ВЕЛИК ДА Е ДЕНЯТ"]], [[null, "ВЪВ КОЙТО"]], [[null, "ИСУС ВЪЗКРЪСНА ЗА НАС."]]]}, {"title": "Бридж", "lines": [[[null, "АЗ ТЕ МОЛЯ С МЕНЕ БЪДИ,"]], [[null, "БЛАГОСЛАВЯЙ МЕ ИСУСЕ,"]], [[null, "КАКТО ВСЕКИ ДЕН СЕ МОЛЯ."]], [[null, "ТИ БЪДИ В МОЯ ЖИВОТ,"]], [[null, "АЗ НА ТЕБЕ УПОВАВАМ,"]], [[null, "БОГ НА ЛЮБОВТА"]], [[null, "И ВЕЧНОСТТА."]]]}]}
