{"id": "167", "sections": [{"title": "Куплет 1", "lines": [[[null, "АЗ СЕ ЛЮБУВАХ"]], [[null, "НА ЖИВОТА ВЪВ ГРЯХ,"]], [[null, "ВОДЕН В ПОРОЦИ, СРЕЩИ И СМЯХ."]], [[null, "НО БОГ МЕ СРЕЩНА"]], [[null, "КАТО ЛЪЧ ВЪВ НОЩТА,"]], [[null, "СЛАВА БОГУ ВИДЯХ СВЕТЛИНА!"]]]}, {"title": "Припев", "lines": [[[null, "ВСРЕД СВЕТЛИНА, ВСРЕД СВЕТЛИНА!"]], [[null, "НЯМА ВЕЧ' СЪЛЗИ, НЯМА ТЪМА!"]], [[null, "АЗ СЪМ ЩАСТЛИВ"]], [[null, "И БЕЗ ГРИЖИ И ЗЛО."]], [[null, "СЛАВА БОГУ ВИДЯХ СВЕТЛИНА!"]]]}, {"title": "Куплет 2", "lines": [[[null, "КАТО СЛЕПЕЦ АЗ СЕ БЛЪСКАХ САМИН"]], [[null, "В ЯДОВЕ, СЪЛЗИ, ВСИЧКИТЕ ДНИ."]], [[null, "НО БОГ СМЕНИ ВСИЧКО"]], [[null, "СЪС СВОЙТА МОЩ,"]], [[null, "СЛАВА БОГУ ВИДЯХ СВЕТЛИНА!"]]]}, {"title": "Куплет 3", "lines": [[[null, "БЯХ ИЗОСТАВЕН,"]], [[null, "ИЗМЪЧЕН, ПРЕЗРЯН..."]], [[null, "КАТ' ЧУЖДЕНЕЦ БЕЗ ДОМ И БЕЗ БЛЯН."]], [[null, "СЕГА МЕ ВОДИ НАЙ-ВАЖНАТА ЦЕЛ."]], [[null, "СЛАВА БОГУ ВИДЯХ СВЕТЛИНА!"]]]}]}
