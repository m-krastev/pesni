{"id": "188", "sections": [{"title": "Куплет 1", "lines": [[[null, "СЛАВА И ХВАЛА"]], [[null, "ИЗПЪЛВАТ ХРАМА ТИ."]], [[null, "АНГЕЛИ - ПЕЯТ С НАС СЕГА."]], [[null, "С РАДОСТ"]], [[null, "ДНЕС ВЪВ ТВОЯ ДОМ ПРАЗНУВАМЕ"]], [[null, "И ИЗДИГАМЕ ХВАЛА -"]], [[null, "ПРЕД ТВОЯ ТРОН."]]]}, {"title": "Куплет 2", "lines": [[[null, "ЦЪРКВАТА НА ТЕЗИ ДНИ"]], [[null, "ИЗДИГА ДНЕС ГЛАВА."]], [[null, "ТИ ИЗПЪЛВАШ УСТНИТЕ НИ"]], [[null, "ВСЕКИ ДЕН С ХВАЛА,"]], [[null, "С НОВА СИЛА - СВОЯ ДУХ"]], [[null, "ИЗЛИВАШ ВЪРХУ НАС."]], [[null, "ТИ ИДВАШ ДА ЦАРУВАШ"]], [[null, "В НАШАТА ЗЕМЯ."]]]}, {"title": "Припев", "lines": [[[null, "ЩЕ БЛАГОСЛАВЯМ ИМЕТО ТИ,"]], [[null, "ЩЕ БЛАГОСЛАВЯМ - ТИ СИ СВЯТ,"]], [[null, "ЩЕ БЛАГОСЛАВЯМ ИМЕТО ТИ,"]], [[null, "ЩЕ БЛАГОСЛАВЯМ МОЯТ ЦАР."]]]}]}
