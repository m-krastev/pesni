{"id": "178", "sections": [{"title": "", "lines": [[[null, "(1 КОРИНТЯНИ 13 ГЛАВА)"]]]}, {"title": "Куплет 1", "lines": [[[null, "АКО ГОВОРЯ"]], [[null, "С АНГЕЛСКИ ЕЗИЦИ,"]], [[null, "АКО ЗНАЯ ВСИЧКИ ТАЙНИ,"]], [[null, "АКО ИМАМ ВСЯКО ЗНАНИЕ,"]], [[null, "АКО МОГА ПЛАНИНИТЕ"]], [[null, "ДА ПРЕМЕСТЯ,"]], [[null, "АКО ДАМ ИМОТА СИ"]], [[null, "НА ГЛАДНИТЕ,"]], [[null, "АКО ДАМ ТЕЛОТО НА СМЪРТТА..."]]]}, {"title": "Припев", "lines": [[[null, "ЛЮБОВТА, ЛЮБОВТА"]], [[null, "АКО ЛИПСВА"]], [[null, "ВЪВ СЪРЦАТА НИ,"]], [[null, "НИЙ СМЕ МЕД ЩО ЗВЪНТИ"]], [[null, "И КИМВАЛ ЩО ДРЪНКА!"]]]}, {"title": "Куплет 2", "lines": [[[null, "ЛЮБОВТА ТЪРПИ И НЕ ЗАВИЖДА,"]], [[null, "НЕ СЕ ПРЕВЪЗНАСЯ"]], [[null, "И НЕ СЕ ГОРДЕЕ,"]], [[null, "ВСИЧКО ПРЕМЪЛЧАВА,"]], [[null, "НА ВСИЧКО ХВАЩА ВЯРА,"]], [[null, "НА ВСИЧКО СЕ НАДЯВА,"]], [[null, "ВСИЧКО ПРЕТЪРПЯВА,"]], [[null, "НЕ СЕ РАЗДРАЗНЯВА,"]], [[null, "НЕ ТЪРСИ СВОЕТО,"]], [[null, "НЕ РАДВА СЕ НА ЗЛО,"]], [[null, "КОПНЕЕ ЗА ДОБРО."]]]}, {"title": "Куплет 3", "lines": [[[null, "ЗНАЙТЕ, ЛЮБОВТА"]], [[null, "НИВГА НЕ ОТПАДА"]], [[null, "КАКТО ДРУГИ ДАРБИ,"]], [[null, "КОИТО ПРЕКРАТЯВАТ"]], [[null, "ЗАЩОТО, ОТЧАСТИ"]], [[null, "ДНЕС ВИЖДАМЕ НЕЩАТА"]], [[null, "В ТОЗИ СВЯТ ИЗПЪЛНЕН"]], [[null, "С ГРЯХ И СУЕТА."]], [[null, "И ТЪЙ, ОСТАВАТ ВЯРА,"]], [[null, "НАДЕЖДА И ЛЮБОВ,"]], [[null, "НО НАЙ-ГОЛЯМАТА Е ЛЮБОВТА."]]]}]}
