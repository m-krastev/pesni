{"id": "171", "sections": [{"title": "Куплет 1", "lines": [[[null, "АЗ ИМАМ СЪЗДАТЕЛ,"]], [[null, "ТОЙ НАПРАВИ СЪРЦЕТО МИ"]], [[null, "ПРЕДИ СЪТВОРЕНИЕТО,"]], [[null, "АЗ СЪМ БИЛ В РЪЦЕТЕ МУ!"]]]}, {"title": "Припев", "lines": [[[null, "ТОЙ ЗНАЕ ИМЕТО МИ,"]], [[null, "ТОЙ ЗНАЕ МИСЛИТЕ МИ"]], [[null, "ТОЙ ВИЖДА СЪЛЗИТЕ МИ"]], [[null, "И ЧУВА МОЯ ВИК."]]]}, {"title": "Куплет 2", "lines": [[[null, "АЗ ИМАМ ТАТКО,"]], [[null, "ТОЙ МЕ НАРИЧА СИН"]], [[null, "ТОЙ НЕ МЕ ОСТАВЯ,"]], [[null, "ТАМ КЪДЕТО И ДА СЪМ."]]]}]}
