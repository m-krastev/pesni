{"id": "176", "sections": [{"title": "Куплет 1", "lines": [[[null, "ДЪРЗОСТЕН И СМЕЛ"]], [[null, "И НАСЪРЧЕН БЪДИ,"]], [[null, "И СИЛЕН В ГОСПОДА,"]], [[null, "И СИЛЕН В ГОСПОДА!"]]]}, {"title": "Куплет 2", "lines": [[[null, "НЕ СЕ СТРАХУВАЙ ТИ, НО ЗНАЙ"]], [[null, "НЕБЕСНИЯТ БАЩА"]], [[null, "НЕ ТЕ ОСТАВЯ НИКОГА,"]], [[null, "ТОЙ БДИ С ТЕБ ВСЯКОГА."]]]}, {"title": "Куплет 3", "lines": [[[null, "ИМАМЕ ПОБЕДА,"]], [[null, "ПОБЕДНА СИЛА,"]], [[null, "ИМАМЕ ПОБЕДА"]], [[null, "В ИМЕТО НА ИСУСА!"]]]}, {"title": "Куплет 4", "lines": [[[null, "И ВРАГОВЕТЕ НИКОГА НЯМА"]], [[null, "ДА НИ УНИЩОЖАТ,"]], [[null, "ЗАЩОТО ИМАМЕ"]], [[null, "ПОБЕДНА СИЛА,"]], [[null, "ИМАМЕ ПОБЕДА"]], [[null, "В ИМЕТО НА ИСУСА!"]]]}, {"title": "Куплет 5", "lines": [[[null, "ИЗПЪЛНИ СЪРЦЕ МИ"]], [[null, "ДУШЕ СВЯТИ,"]], [[null, "ИЗПЪЛНИ СЪС СИЛАТА СИ ТИ!"]]]}, {"title": "Куплет 6", "lines": [[[null, "ЗАВЛАДЕЙ СЪРЦЕТО МИ, ЗАВЛАДЕЙ!"]], [[null, "ДА ПРИНАДЛЕЖА"]], [[null, "САМО НА ТЕБЕ!"]]]}, {"title": "Куплет 7", "lines": [[[null, "НА БОЖИЯТ ОЛТАР"]], [[null, "ГОРИ СЕГА СВЯТ ОГЪН."]]]}, {"title": "Куплет 8", "lines": [[[null, "НЕ ЩЕ ГО НИЩО УГАСИ,"]], [[null, "НЕ ЩЕ ГО НИЩО УГАСИ,"]], [[null, "ОГЪНЯТ СВЕТИ ГОРИ"]], [[null, "ВЪТРЕ ВЪВ СЪРЦЕТО МИ!"]]]}, {"title": "Куплет 9", "lines": [[[null, "СВИРЯТ ТРЪБИТЕ ОТ СИОНА,"]], [[null, "ГОСПОД ИДЕ С ГОЛЯМА СЛАВА"]], [[null, "СВИРЯТ ТРЪБИТЕ ОТ СИОНА"]], [[null, "ТОЙ ИДЕ ОТ НЕБЕ!"]]]}]}
