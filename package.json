{
  "name": "pesni",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "songs": "node scripts/build-songs.mjs",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "prestart": "npm run songs",
    "start": "NODE_OPTIONS=--max-old-space-size=8192 docusaurus start",
    "prebuild": "npm run songs",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "bash scripts/deploy.sh",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.52.1",
    "@fontsource/inter": "^5.3.0",
    "@mdx-js/react": "^3.1.0",
    "@tombatossals/chords-db": "^0.5.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "chordsheetjs": "18.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Bulgarian worship songbook: pesni.propovedi.org"
}
